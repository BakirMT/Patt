{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account metadata for SMART PATT BOOK.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Person": {
      "title": "Person",
      "description": "An individual or counterparty tracked in the user's ledger with a manually assigned unique person code.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9_\\-\\. ]+$"
        },
        "codeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "place": {
          "type": "string",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "code", "codeKey", "phone", "place", "email", "notes", "createdAt", "updatedAt"]
    },
    "PersonCodeIndex": {
      "title": "PersonCodeIndex",
      "description": "Concurrency-safe uniqueness lock ensuring each manually entered person code is unique per user account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "personId", "code", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial ledger entry linked to a person for given, received, payable, or paid money.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["GIVEN", "RECEIVED", "PAYABLE", "PAID"]
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary amount rounded to 2 decimal places."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "referenceNumber": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "personId", "type", "amount", "date", "description", "referenceNumber", "createdAt", "updatedAt"]
    },
    "UserSetting": {
      "title": "UserSetting",
      "description": "Per-user settings document storing preferences or server-hashed PIN credentials (never plaintext PIN).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "settingType": {
          "type": "string",
          "enum": ["preferences", "pin"]
        },
        "currencyCode": {
          "type": "string",
          "maxLength": 10
        },
        "currencySymbol": {
          "type": "string",
          "maxLength": 10
        },
        "pinEnabled": {
          "type": "boolean"
        },
        "pinHash": {
          "type": "string",
          "maxLength": 256
        },
        "pinSalt": {
          "type": "string",
          "maxLength": 128
        },
        "pinLength": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "settingType", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account root document owned strictly by userId."
    },
    "/users/{userId}/persons/{personId}": {
      "schema": { "$ref": "#/entities/Person" },
      "description": "Persons managed inside a user's private ledger."
    },
    "/users/{userId}/personCodes/{codeKey}": {
      "schema": { "$ref": "#/entities/PersonCodeIndex" },
      "description": "Unique person code reservation documents preventing duplicate codes per user."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Financial transactions (GIVEN, RECEIVED, PAYABLE, PAID) belonging to userId."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSetting" },
      "description": "User preferences and server-hashed PIN configuration."
    }
  }
}
